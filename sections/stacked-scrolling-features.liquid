{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .stacked-scrolling-wrapper {
    position: relative;
  }

  .stacked-scrolling-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    background-size: cover;
    background-position: center;
    background-attachment: fixed; 
  }

  .stacked-scrolling-container {
    position: relative;
    z-index: 1;
    margin: 0 auto;
  }

  .stacked-card {
    position: sticky;
    top: 0;
    padding: 3rem 0;
    display: flex;
    background: rgb(var(--color-background));
    border-radius: 0;
    box-shadow: none;
    overflow: hidden;
    transition: transform 0.3s ease;
  }
  

  .stacked-card-inner {
    width: 100%;
    display: flex;
    padding: 1rem;
  }

  @media screen and (min-width: 750px) {
    .stacked-card-inner {
      padding: 3rem;
    }
  }

  /* Z-index stacking for cards */
  {% for block in section.blocks %}
    #StackedCard-{{ block.id }} {
      z-index: {{ forloop.index }};
      top: 0;
    }
  {% endfor %}

  .stacked-card__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    width: 100%;
    height: 100%;
    gap: 4rem;
  }

  .stacked-card__content, .stacked-card__media {
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .stacked-card__content, .stacked-card__media {
      width: calc(50% - 2rem);
    }
    .stacked-card__grid--reverse .stacked-card__content {
      order: 2;
    }
    .stacked-card__grid--reverse .stacked-card__media {
      order: 1;
    }
  }

  .stacked-card__media {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stacked-card__media img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--media-radius);
  }

  .stacked-card__text {
    margin-top: 2rem;
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.75);
  }
  
  .stacked-card .h1 {
    margin-bottom: 1rem;
  }
{%- endstyle -%}

<div class="stacked-scrolling-wrapper color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- if section.settings.background_image != blank -%}
    <div class="stacked-scrolling-bg" style="background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');"></div>
  {%- endif -%}

  <div class="stacked-scrolling-container">
    {%- for block in section.blocks -%}
      {%- liquid
        assign is_reverse = false
        assign mod = forloop.index | modulo: 2
        if mod == 0
          assign is_reverse = true
        endif
      -%}
      <div id="StackedCard-{{ block.id }}" class="stacked-card color-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}
        {% if block.settings.bg_image != blank %}
          style="background-image: url('{{ block.settings.bg_image | image_url: width: 2000 }}'); background-size: cover; background-position: center;"
        {% endif %}
      >
        <div class="stacked-card-inner page-width">
          <div class="stacked-card__grid {% if is_reverse %}stacked-card__grid--reverse{% endif %}">
            
            <div class="stacked-card__content">
              {%- if block.settings.heading != blank -%}
                <h2 class="h1">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="stacked-card__text rte">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a href="{{ block.settings.button_link }}" class="button button--primary" style="margin-top: 3rem;">
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            </div>

            <div class="stacked-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Stacked Scrolling Cards",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image (Fixed)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section Background Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Stacked Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Background Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Card Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add some descriptive text here.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Card Color Scheme",
          "default": "scheme-1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stacked Scrolling Cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
