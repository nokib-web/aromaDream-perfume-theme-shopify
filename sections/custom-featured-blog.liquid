{%- style -%}
  .custom-blog {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .custom-blog {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .custom-blog__header {
    margin-bottom: 4rem;
  }
  .custom-blog__heading {
    font-family: var(--font-heading-family);
    font-size: 3.2rem;
    font-weight: 700;
    color: rgb(var(--color-foreground));
    margin-bottom: 1rem;
  }
  .custom-blog__subheading {
    color: rgba(var(--color-foreground), 0.75);
    font-size: 1.6rem;
  }

  /* Grid Layout */
  .custom-blog__grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  @media screen and (min-width: 990px) {
    .custom-blog__grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 4rem;
    }
  }

  /* Featured Left Side */
  .custom-blog__featured {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media screen and (min-width: 750px) {
    .custom-blog__featured {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .custom-blog__featured-card {
    display: flex;
    flex-direction: column;
  }
  .custom-blog__image-link {
    display: block;
    border-radius: 1rem;
    overflow: hidden;
    margin-bottom: 2rem;
    background: rgba(var(--color-foreground), 0.04);
  }
  .custom-blog__image-link .media {
    padding-bottom: 80%; /* Almost square/landscape */
  }

  .custom-blog__meta {
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.6);
    margin-bottom: 0.8rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .custom-blog__tag {
    font-weight: 600;
    color: rgb(var(--color-foreground));
  }

  .custom-blog__title {
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 700;
    color: rgb(var(--color-foreground));
    margin: 0 0 1.2rem 0;
    line-height: 1.3;
  }
  .custom-blog__title a {
    text-decoration: none;
    color: inherit;
  }
  .custom-blog__title a:hover {
    text-decoration: underline;
  }

  .custom-blog__excerpt {
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.75);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .custom-blog__read-more {
    font-size: 1.4rem;
    font-weight: 700;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
  }
  .custom-blog__read-more:hover {
    text-decoration: underline;
  }

  /* List Right Side */
  .custom-blog__list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .custom-blog__list-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
  }
  .custom-blog__list-card:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .custom-blog__list-image-link {
    flex: 0 0 120px;
    border-radius: 0.8rem;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.04);
  }
  .custom-blog__list-image-link .media {
    padding-bottom: 65%; /* Landscape thumbnail */
  }

  .custom-blog__list-content {
    flex: 1;
  }
  .custom-blog__title--small {
    font-size: 1.5rem;
    margin-bottom: 0;
  }

  /* Footer Button */
  .custom-blog__footer {
    margin-top: 5rem;
  }
{%- endstyle -%}

<div class="custom-blog section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="custom-blog__header center">
        {%- if section.settings.heading != blank -%}
          <h2 class="custom-blog__heading inline-richtext">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="custom-blog__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
      <div class="custom-blog__grid">
        {%- assign articles = section.settings.blog.articles -%}
        
        <div class="custom-blog__featured">
          {%- for article in articles limit: 2 -%}
            <div class="custom-blog__featured-card">
              <a href="{{ article.url }}" class="custom-blog__image-link">
                {%- if article.image -%}
                  <div class="media media--transparent">
                    {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                  </div>
                {%- else -%}
                  <div class="media media--transparent">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </a>
              <div class="custom-blog__content">
                <div class="custom-blog__meta">
                  <span class="custom-blog__date">{{ article.published_at | date: "%d-%m-%Y" }}</span>
                  <span class="custom-blog__tag">News</span>
                </div>
                <h3 class="custom-blog__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
                <div class="custom-blog__excerpt">
                  {%- if article.excerpt.size > 0 -%}
                    {{ article.excerpt | strip_html | truncatewords: 25 }}
                  {%- else -%}
                    {{ article.content | strip_html | truncatewords: 25 }}
                  {%- endif -%}
                </div>
                <a href="{{ article.url }}" class="custom-blog__read-more">Read More &rsaquo;</a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="custom-blog__list">
          {%- for article in articles offset: 2 limit: 4 -%}
            <div class="custom-blog__list-card">
              <a href="{{ article.url }}" class="custom-blog__list-image-link">
                {%- if article.image -%}
                  <div class="media media--transparent">
                    {{ article.image | image_url: width: 250 | image_tag: loading: 'lazy' }}
                  </div>
                {%- else -%}
                  <div class="media media--transparent">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </a>
              <div class="custom-blog__list-content">
                <div class="custom-blog__meta">
                  <span class="custom-blog__date">{{ article.published_at | date: "%d-%m-%Y" }}</span>
                  <span class="custom-blog__tag">News</span>
                </div>
                <h3 class="custom-blog__title custom-blog__title--small"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="custom-blog__footer center">
        <a href="{{ section.settings.blog.url }}" class="button button--primary">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- else -%}
      <div class="custom-blog__grid">
        <div class="custom-blog__featured">
          {%- for i in (1..2) -%}
            <div class="custom-blog__featured-card">
              <div class="custom-blog__image-link">
                <div class="media media--transparent">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
              <div class="custom-blog__content">
                <div class="custom-blog__meta">
                  <span class="custom-blog__date">{{ 'now' | date: "%d-%m-%Y" }}</span>
                  <span class="custom-blog__tag">News</span>
                </div>
                <h3 class="custom-blog__title">Dummy blog</h3>
                <div class="custom-blog__excerpt">
                  Welcome to the AromaDream blog! Discover tips on creating the perfect ambient scent for your home or business, and learn how to get the most out of your diffusers.
                </div>
                <span class="custom-blog__read-more">Read More &rsaquo;</span>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="custom-blog__list">
          {%- for i in (1..4) -%}
            <div class="custom-blog__list-card">
              <div class="custom-blog__list-image-link">
                <div class="media media--transparent">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
              <div class="custom-blog__list-content">
                <div class="custom-blog__meta">
                  <span class="custom-blog__date">{{ 'now' | date: "%d-%m-%Y" }}</span>
                  <span class="custom-blog__tag">News</span>
                </div>
                <h3 class="custom-blog__title custom-blog__title--small">Dummy blog-{{ i | plus: 2 }}</h3>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="custom-blog__footer center">
        <a href="#" class="button button--primary">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom Featured Blog",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Our Latest Blog Posts",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Discover the benefits of aromatherapy, tips for choosing scent oils, and guides to our premium diffusers.</p>",
      "label": "Subheading"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "See All Blog Posts",
      "label": "Button label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Blog"
    }
  ]
}
{% endschema %}
