{%- style -%}
  .trust-bar-{{ section.id }} {
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
    padding: 1.5rem 0;
  }

  .trust-bar__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    row-gap: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .trust-bar__grid {
      grid-template-columns: repeat({{ section.blocks.size | default: 4 | at_most: 4 }}, 1fr);
      row-gap: 0;
    }
  }

  .trust-bar__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    padding: 0 1rem;
    border-right: 1px solid rgba(var(--color-foreground), 0.15);
  }

  /* Handle dividers based on mobile (2 cols) vs desktop (4 cols) */
  .trust-bar__item:nth-child(even) {
    border-right: none;
  }
  
  @media screen and (min-width: 750px) {
    .trust-bar__item:nth-child(even) {
      border-right: 1px solid rgba(var(--color-foreground), 0.15);
    }
    .trust-bar__item:last-child,
    .trust-bar__item:nth-child(4n) {
      border-right: none;
    }
  }

  .trust-bar__icon {
    width: {{ section.settings.icon_width }}px;
    height: {{ section.settings.icon_width }}px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .trust-bar__icon--placeholder {
    background: rgba(var(--color-foreground), 0.05);
    border-radius: 50%;
    padding: 0.5rem;
  }

  .trust-bar__text {
    font-size: 1.4rem;
    line-height: 1.3;
    margin: 0;
    color: rgb(var(--color-foreground));
  }
  .trust-bar__text p {
    margin: 0;
  }
  .trust-bar__text strong, .trust-bar__text b {
    font-weight: 700;
  }
  .trust-bar__text em, .trust-bar__text i {
    font-style: italic;
  }
{%- endstyle -%}

<div class="trust-bar-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="trust-bar__grid">
      {%- for block in section.blocks -%}
        <div class="trust-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 100 | image_tag: class: 'trust-bar__icon', loading: 'lazy' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'trust-bar__icon trust-bar__icon--placeholder placeholder-svg' }}
          {%- endif -%}
          
          <div class="trust-bar__text inline-richtext">
            {{ block.settings.title }}
          </div>
        </div>
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="trust-bar__item">
            {{ 'image' | placeholder_svg_tag: 'trust-bar__icon trust-bar__icon--placeholder placeholder-svg' }}
            <div class="trust-bar__text inline-richtext">
              <strong>Trust Item {{ i }}</strong> Details
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "icon_width",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Icon width",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Icon/Logo"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "<strong>Free Shipping</strong> on orders over $50",
          "label": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" }
      ]
    }
  ]
}
{% endschema %}
