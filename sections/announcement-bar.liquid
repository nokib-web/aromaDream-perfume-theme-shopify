{%- style -%}
  #AnnouncementBar-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#121212' }};
    {%- if section.settings.bg_image != blank -%}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-position: center center;
      background-size: cover;
      background-repeat: no-repeat;
    {%- endif -%}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: {%- if section.settings.show_line_separator -%}1px solid rgba(255, 255, 255, 0.1){%- else -%}none{%- endif -%};
  }

  .ticker-wrapper-{{ section.id }} {
    overflow: hidden;
    white-space: nowrap;
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .ticker-content-{{ section.id }} {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .ticker-direction-left-{{ section.id }} {
    animation: ticker-left-{{ section.id }} {{ section.settings.ticker_speed }}s linear infinite;
  }

  .ticker-direction-right-{{ section.id }} {
    animation: ticker-right-{{ section.id }} {{ section.settings.ticker_speed }}s linear infinite;
  }

  {%- if section.settings.pause_on_hover -%}
    .ticker-wrapper-{{ section.id }}:hover .ticker-content-{{ section.id }} {
      animation-play-state: paused;
    }
  {%- endif -%}

  @keyframes ticker-left-{{ section.id }} {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes ticker-right-{{ section.id }} {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0%);
    }
  }

  .ticker-item-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body-family), inherit;
    font-size: {{ section.settings.font_size }}px;
    letter-spacing: {{ section.settings.letter_spacing }}px;
    color: {{ section.settings.text_color | default: '#FFFFFF' }};
    padding: 0 16px;
    text-transform: uppercase;
  }

  .ticker-item-{{ section.id }} a {
    color: {{ section.settings.text_color | default: '#FFFFFF' }};
    text-decoration: none;
    transition: opacity 0.2s ease;
    display: inline-flex;
    align-items: center;
  }

  .ticker-item-{{ section.id }} a:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .ticker-icon-{{ section.id }} {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
    margin-right: 8px;
    display: inline-block;
    vertical-align: middle;
  }

  .ticker-separator-{{ section.id }} {
    display: inline-block;
    margin-left: 24px;
    color: {{ section.settings.separator_color | default: '#E0C38C' }};
    opacity: 0.8;
  }
{%- endstyle -%}

<div id="AnnouncementBar-{{ section.id }}" class="announcement-bar-ticker" role="region" aria-label="Announcement Bar">
  {%- if section.blocks.size > 0 -%}
    <div class="ticker-wrapper-{{ section.id }}">
      <div class="ticker-content-{{ section.id }} ticker-direction-{{ section.settings.direction }}-{{ section.id }}">
        {%- for i in (1..6) -%}
          <div class="ticker-track" style="display: flex; align-items: center;">
            {%- for block in section.blocks -%}
              <span class="ticker-item-{{ section.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">
                    {%- if block.settings.icon != blank -%}
                      <img
                        src="{{ block.settings.icon | image_url: width: 100 }}"
                        alt=""
                        class="ticker-icon-{{ section.id }}"
                        loading="lazy"
                      >
                    {%- endif -%}
                    <span>{{ block.settings.text | escape }}</span>
                  </a>
                {%- else -%}
                  {%- if block.settings.icon != blank -%}
                    <img
                      src="{{ block.settings.icon | image_url: width: 100 }}"
                      alt=""
                      class="ticker-icon-{{ section.id }}"
                      loading="lazy"
                    >
                  {%- endif -%}
                  <span>{{ block.settings.text | escape }}</span>
                {%- endif -%}

                {%- if section.settings.separator != blank -%}
                  <span class="ticker-separator-{{ section.id }}">{{ section.settings.separator }}</span>
                {%- endif -%}
              </span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Horizontal Ticker Bar",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "🎨 Background & Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#121212",
      "info": "Charcoal Black default"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Optional Upload)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator Symbol Color",
      "default": "#E0C38C"
    },
    {
      "type": "header",
      "content": "⚡ Ticker Controls"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        {
          "value": "left",
          "label": "Right to Left (←)"
        },
        {
          "value": "right",
          "label": "Left to Right (→)"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "s",
      "label": "Ticker Speed (Seconds)",
      "default": 40,
      "info": "Larger number = slower, smoother animation."
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause Ticker on Mouse Hover",
      "default": true
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator Symbol between items",
      "default": "✦"
    },
    {
      "type": "header",
      "content": "🖼️ Icon Settings"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Icon Display Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "✍️ Typography & Spacing"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 13,
      "info": "Inherits font-family from Global Theme typography."
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Top Padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "label": "Show Bottom Line Border Separator",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image (Optional)"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Free Delivery across UAE on orders over AED 250",
          "label": "Announcement Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Horizontal Ticker Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "FREE DELIVERY OVER AED 250 ACROSS THE UAE"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "CASH ON DELIVERY AVAILABLE"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "IFRA-CERTIFIED SAFETY TESTED FRAGRANCES"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "FREE 20-MIN ON-SITE SCENT CONSULTATION FOR BUSINESSES"
          }
        }
      ]
    }
  ]
}
{% endschema %}
