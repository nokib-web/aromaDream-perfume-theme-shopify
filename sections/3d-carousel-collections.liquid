{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  :root {
    --card-3d-width: 280px;
    --card-3d-height: 340px;
    --card-3d-offset: 210px;
    --card-3d-rotate: 30deg;
  }

  @media screen and (min-width: 750px) {
    :root {
      --card-3d-width: 420px;
      --card-3d-height: 500px;
      --card-3d-offset: 340px;
      --card-3d-rotate: 32deg;
    }
  }

  @media screen and (min-width: 1100px) {
    :root {
      --card-3d-width: 560px;
      --card-3d-height: 640px;
      --card-3d-offset: 460px;
      --card-3d-rotate: 34deg;
    }
  }

  .carousel-3d__section {
    position: relative;
    width: 100%;
    /* Clip horizontally to hide overflow, allow vertical */
    overflow: hidden;
  }

  .carousel-3d__wrapper {
    position: relative;
    padding-top: 4rem;
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .carousel-3d__container {
    position: relative;
    width: 100%;
    /* height = card height so side cards align flush top to bottom */
    height: var(--card-3d-height);
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 1200px;
    perspective-origin: 50% 50%;
    /* Overflow visible so side cards peek out past container */
    overflow: visible;
  }

  .carousel-3d__slide {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--card-3d-width);
    height: var(--card-3d-height);
    overflow: hidden;
    cursor: pointer;
    will-change: transform, opacity, filter;
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1),
                opacity 0.65s ease,
                filter 0.65s ease;
    background-size: cover;
    background-position: center;
  }

  /* CENTER */
  .carousel-3d__slide[data-pos="center"] {
    transform: translate3d(-50%, -50%, 0) rotateY(0deg);
    transform-origin: center center;
    z-index: 10;
    opacity: 1;
    filter: brightness(1);
    cursor: default;
  }

  /* LEFT - folded like a book page turning left */
  .carousel-3d__slide[data-pos="left"] {
    transform: translate3d(calc(-50% - var(--card-3d-offset)), -50%, -50px) rotateY(calc(-1 * var(--card-3d-rotate)));
    transform-origin: right center;
    z-index: 5;
    opacity: 1;
    filter: brightness(0.8);
  }

  /* RIGHT - folded like a book page turning right */
  .carousel-3d__slide[data-pos="right"] {
    transform: translate3d(calc(-50% + var(--card-3d-offset)), -50%, -50px) rotateY(var(--card-3d-rotate));
    transform-origin: left center;
    z-index: 5;
    opacity: 1;
    filter: brightness(0.8);
  }

  /* HIDDEN FAR LEFT */
  .carousel-3d__slide[data-pos="hidden-left"] {
    transform: translate3d(calc(-50% - var(--card-3d-offset) * 1.6), -50%, -300px) rotateY(calc(-1.2 * var(--card-3d-rotate)));
    transform-origin: right center;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  /* HIDDEN FAR RIGHT */
  .carousel-3d__slide[data-pos="hidden-right"] {
    transform: translate3d(calc(-50% + var(--card-3d-offset) * 1.6), -50%, -300px) rotateY(calc(1.2 * var(--card-3d-rotate)));
    transform-origin: left center;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .carousel-3d__slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0,0,0,0) 20%,
      rgba(0,0,0,0.25) 55%,
      rgba(0,0,0,0.8) 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem 2.5rem;
    box-sizing: border-box;
    color: #fff;
  }

  .carousel-3d__step {
    font-size: 1.1rem;
    letter-spacing: 0.2rem;
    opacity: 0.75;
    font-weight: 400;
    align-self: flex-end;
  }

  .carousel-3d__content {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .carousel-3d__title {
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.2;
    color: #fff;
  }

  @media screen and (min-width: 750px) {
    .carousel-3d__title {
      font-size: 2.6rem;
    }
  }

  .carousel-3d__desc {
    font-size: 1.3rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
    max-width: 320px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .carousel-3d__slide[data-pos="left"] .carousel-3d__desc,
  .carousel-3d__slide[data-pos="right"] .carousel-3d__desc,
  .carousel-3d__slide[data-pos="left"] .carousel-3d__btn,
  .carousel-3d__slide[data-pos="right"] .carousel-3d__btn {
    opacity: 0;
    pointer-events: none;
  }

  /* Side cards: show only small label */
  .carousel-3d__side-label {
    position: absolute;
    bottom: 2rem;
    left: 2.5rem;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
  }

  .carousel-3d__slide[data-pos="center"] .carousel-3d__side-label {
    display: none;
  }

  .carousel-3d__slide[data-pos="left"] .carousel-3d__slide-overlay,
  .carousel-3d__slide[data-pos="right"] .carousel-3d__slide-overlay {
    display: none;
  }

  .carousel-3d__slide[data-pos="left"] .carousel-3d__side-label,
  .carousel-3d__slide[data-pos="right"] .carousel-3d__side-label {
    display: block;
  }

  .carousel-3d__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.2rem 3rem;
    background: transparent !important;
    color: #fff !important;
    border: 2px solid rgba(255,255,255,0.85);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.15rem;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--buttons-radius, 4px);
    margin-top: 0.5rem;
    width: fit-content;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  }

  .carousel-3d__btn:hover {
    background: rgba(255,255,255,0.15) !important;
    color: #fff !important;
    border-color: #fff;
    transform: translateY(-2px);
  }

  /* Navigation arrows */
  .carousel-3d__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.2rem;
    margin-top: 2rem;
  }

  .carousel-3d__arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid rgba(var(--color-foreground), 0.25);
    background: transparent;
    color: rgb(var(--color-foreground));
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .carousel-3d__arrow:hover {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-color: rgb(var(--color-foreground));
  }
{%- endstyle -%}

<div class="carousel-3d__section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- if section.settings.title != blank -%}
    <div class="page-width title-wrapper title-wrapper--no-top-margin center" style="margin-bottom: 2rem;">
      <h2 class="title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="carousel-3d__wrapper">
    <div class="carousel-3d__container" id="Carousel3D-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div
          class="carousel-3d__slide"
          data-index="{{ forloop.index0 }}"
          data-pos=""
          style="background-image: url('{{ block.settings.image | image_url: width: 1200 }}');"
          {{ block.shopify_attributes }}
        >
          <div class="carousel-3d__slide-overlay">
            <span class="carousel-3d__step">/ 0{{ forloop.index }}</span>
            <div class="carousel-3d__content">
              {%- if block.settings.title != blank -%}
                <h3 class="carousel-3d__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="carousel-3d__desc">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a href="{{ block.settings.button_link }}" class="carousel-3d__btn">
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            </div>
          </div>
          <span class="carousel-3d__side-label">{{ block.settings.title }}</span>
        </div>
      {%- endfor -%}
    </div>

    <div class="carousel-3d__nav">
      <button type="button" class="carousel-3d__arrow carousel-3d__arrow--prev" aria-label="{{ 'general.slider.previous_slide' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="carousel-3d__arrow carousel-3d__arrow--next" aria-label="{{ 'general.slider.next_slide' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
(function() {
  function initCarousel3D(stageId) {
    const stage = document.getElementById(stageId);
    if (!stage) return;

    const wrapper = stage.closest('.carousel-3d__section');
    const slides = Array.from(stage.querySelectorAll('.carousel-3d__slide'));
    const prevBtn = wrapper.querySelector('.carousel-3d__arrow--prev');
    const nextBtn = wrapper.querySelector('.carousel-3d__arrow--next');
    const total = slides.length;

    if (total === 0) return;

    let currentIndex = 0;

    function getPos(slideIndex) {
      const diff = (slideIndex - currentIndex + total) % total;
      if (diff === 0) return 'center';
      if (diff === 1) return 'right';
      if (diff === total - 1) return 'left';
      if (diff > 1 && diff <= Math.floor(total / 2)) return 'hidden-right';
      return 'hidden-left';
    }

    function render() {
      slides.forEach((slide, i) => {
        slide.setAttribute('data-pos', getPos(i));
      });
    }

    function next() {
      currentIndex = (currentIndex + 1) % total;
      render();
    }

    function prev() {
      currentIndex = (currentIndex - 1 + total) % total;
      render();
    }

    slides.forEach((slide, i) => {
      slide.addEventListener('click', () => {
        const pos = slide.getAttribute('data-pos');
        if (pos === 'right') next();
        else if (pos === 'left') prev();
      });
    });

    if (prevBtn) prevBtn.addEventListener('click', prev);
    if (nextBtn) nextBtn.addEventListener('click', next);

    // Touch/swipe support
    let touchStartX = 0;
    stage.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });

    stage.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) {
        diff > 0 ? next() : prev();
      }
    }, { passive: true });

    // Mouse drag support
    let mouseStartX = 0;
    let isDragging = false;

    stage.addEventListener('mousedown', (e) => {
      mouseStartX = e.clientX;
      isDragging = true;
      stage.style.cursor = 'grabbing';
      e.preventDefault();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
    });

    document.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      stage.style.cursor = '';
      const diff = mouseStartX - e.clientX;
      if (Math.abs(diff) > 40) {
        diff > 0 ? next() : prev();
      }
    });

    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initCarousel3D('Carousel3D-{{ section.id }}'));
  } else {
    initCarousel3D('Carousel3D-{{ section.id }}');
  }
})();
</script>

{% schema %}
{
  "name": "3D Perspective Carousel",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Carousel Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short Description",
          "default": "Elevate your sensory experience."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Explore Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "3D Perspective Carousel",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
