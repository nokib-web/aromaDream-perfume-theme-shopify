{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #Banner-{{ section.id }} {
    {%- if section.settings.custom_bg_color != blank -%}
      background-color: {{ section.settings.custom_bg_color }};
    {%- endif -%}
    {%- if section.settings.image_height == 'custom' -%}
      min-height: {{ section.settings.custom_height_mobile }}px;
    {%- elsif section.settings.image_height == 'full_screen' -%}
      min-height: 85vh;
    {%- endif -%}
  }

  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }} {
      {%- if section.settings.image_height == 'custom' -%}
        min-height: {{ section.settings.custom_height_desktop }}px;
      {%- endif -%}
    }
  }

  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
    {%- if section.settings.custom_overlay_color != blank -%}
      background-color: {{ section.settings.custom_overlay_color }};
    {%- endif -%}
  }

  /* Legibility & Typography Styling */
  #Banner-{{ section.id }} .banner__heading {
    color: {{ section.settings.heading_color | default: '#FFFFFF' }};
    font-weight: {{ section.settings.heading_font_weight | default: '400' }};
    letter-spacing: -0.01em;
    font-family: var(--font-heading-family);
    margin-bottom: 1.2rem;
    {%- if section.settings.enable_text_shadow -%}
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    {%- endif -%}
  }

  #Banner-{{ section.id }} .banner__text {
    color: {{ section.settings.text_color | default: '#FFFFFF' }};
    font-family: var(--font-body-family);
    opacity: 0.95;
    margin-bottom: 2.4rem;
    {%- if section.settings.enable_text_shadow -%}
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    {%- endif -%}
  }

  /* Middle Aligned Buttons Container (Reference: aromadream.ch) */
  #Banner-{{ section.id }} .banner__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center !important;
    width: 100%;
    max-width: 100% !important;
    gap: 12px;
  }

  #Banner-{{ section.id }} .banner__buttons .button {
    font-size: {{ section.settings.button_font_size }}px !important;
    font-weight: {{ section.settings.button_font_weight }} !important;
    padding: {{ section.settings.button_padding_v }}px {{ section.settings.button_padding_h }}px !important;
    min-height: auto !important;
    min-width: auto !important;
    line-height: 1.3 !important;
    border-radius: {{ section.settings.button_corner_radius }}px !important;
    text-transform: none;
    letter-spacing: 0.02em;
    transition: all 0.25s ease;
    {%- if section.settings.enable_button_border -%}
      border: 1px solid rgba(255, 255, 255, 0.8) !important;
    {%- else -%}
      border: none !important;
      outline: none !important;
      box-shadow: none !important;
    {%- endif -%}
  }

  #Banner-{{ section.id }} .banner__buttons .button:after,
  #Banner-{{ section.id }} .banner__buttons .button:before {
    display: none !important;
  }

  /* Primary Solid White Button (Zero Border, Exactly like Reference) */
  #Banner-{{ section.id }} .button--primary-white {
    background-color: #ffffff !important;
    color: #121212 !important;
  }

  #Banner-{{ section.id }} .button--primary-white:hover {
    background-color: #f2f2f2 !important;
    color: #000000 !important;
    transform: translateY(-1px);
  }

  /* Secondary Outline White Button */
  #Banner-{{ section.id }} .button--outline-white {
    background-color: transparent !important;
    color: #ffffff !important;
    border: 1px solid #ffffff !important;
  }

  #Banner-{{ section.id }} .button--outline-white:hover {
    background-color: #ffffff !important;
    color: #121212 !important;
  }

  {%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div
  id="Banner-{{ section.id }}"
  class="banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- if section.settings.video != blank -%}
    <div class="banner__media media">
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'banner__media-video',
          style: 'width: 100%; height: 100%; object-fit: cover;'
      }}
    </div>
  {%- elsif section.settings.image != blank -%}
    <div class="banner__media media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: section.settings.image.height,
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          fetchpriority: fetch_priority
      }}
    </div>
  {%- else -%}
    <div class="banner__media media placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="banner__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2
              class="banner__heading inline-richtext {{ block.settings.heading_size }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.heading }}
            </h2>
          {%- when 'text' -%}
            <div class="banner__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- when 'buttons' -%}
            <div
              class="banner__buttons"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="button button--primary-white"
                >
                  {{- block.settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="button button--outline-white"
                >
                  {{- block.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image-banner.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "🎥 Video & Image Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background Video (Priority)",
      "info": "Upload an MP4 video for smooth ambient background playback."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "🎨 Colors & Text Readability"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "custom_overlay_color",
      "label": "Overlay Tint Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Darkness Opacity",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "enable_text_shadow",
      "label": "Enable Text Contrast Shadow",
      "default": false
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading Font Weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-Bold (600)" }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtext Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "🔘 Button Styling (Reference: aromadream.ch)"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 13
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Button Font Weight",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-Bold (600)" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "button_padding_v",
      "min": 6,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button Top/Bottom Padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "button_padding_h",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Button Left/Right Padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_corner_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Button Corner Radius",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "enable_button_border",
      "label": "Enable Button Border Outline",
      "default": false,
      "info": "Uncheck for zero border clean white button (like reference site)."
    },
    {
      "type": "header",
      "content": "📐 Height & Layout Controls"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        { "value": "adapt", "label": "Adapt to Image Aspect Ratio" },
        { "value": "small", "label": "Small (400px)" },
        { "value": "medium", "label": "Medium (550px)" },
        { "value": "large", "label": "Large (700px)" },
        { "value": "full_screen", "label": "Full Screen (85vh+)" },
        { "value": "custom", "label": "Custom Height (Sliders Below)" }
      ],
      "default": "medium",
      "label": "Banner Height Presets"
    },
    {
      "type": "range",
      "id": "custom_height_desktop",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Custom Desktop Height",
      "default": 550,
      "info": "Active when Banner Height is set to Custom Height."
    },
    {
      "type": "range",
      "id": "custom_height_mobile",
      "min": 250,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Custom Mobile Height",
      "default": 400,
      "info": "Active when Banner Height is set to Custom Height."
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-center", "label": "Top Center" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "middle-left", "label": "Middle Left" },
        { "value": "middle-center", "label": "Middle Center" },
        { "value": "middle-right", "label": "Middle Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-center", "label": "Bottom Center" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "default": "middle-center",
      "label": "Desktop Content Position"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Desktop Content Alignment"
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "default": false,
      "label": "Show Container Box behind text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "📱 Mobile Settings"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Mobile Content Alignment"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Scent devices that transform rooms",
          "label": "Heading Text"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Small (H2)" },
            { "value": "h1", "label": "Medium (H1)" },
            { "value": "h0", "label": "Large (H0)" },
            { "value": "hxl", "label": "Extra Large (HXL)" },
            { "value": "hxxl", "label": "Huge (HXXL)" }
          ],
          "default": "h1",
          "label": "Heading Size"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Swiss room fragrance for hotels, offices and your home",
          "label": "Subtext"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            { "value": "body", "label": "Body Text" },
            { "value": "subtitle", "label": "Subtitle" },
            { "value": "caption-with-letter-spacing", "label": "Uppercase Tag" }
          ],
          "default": "subtitle",
          "label": "Text Style"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "default": "Discover fragrance devices",
          "label": "Primary Button Label"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary Button Label (Optional)"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-banner.presets.name",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
